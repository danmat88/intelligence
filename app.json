{
  "expo": {
    "name": "Profu’ de Mate",
    "slug": "intelligence",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/profu-icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFF8E7",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.rezolvo.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#F6C953",
        "foregroundImage": "./assets/profu-android-foreground.png",
        "backgroundImage": "./assets/profu-android-background.png",
        "monochromeImage": "./assets/profu-android-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/profu-favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "@react-native-google-signin/google-signin",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-firebase/crashlytics",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF8E7"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Profu’ de Mate to use the camera to photograph math problems."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Profu’ de Mate to access your photos to solve problems from images.",
          "cameraPermission": "Allow Profu’ de Mate to use the camera to snap math problems."
        }
      ],
      [
        "react-native-edge-to-edge",
        {
          "android": {
            "enforceNavigationBarContrast": false
          }
        }
      ]
    ],
    "owner": "matdan88-studio",
    "extra": {
      "eas": {
        "projectId": "02602e9d-57be-4486-8138-7e8650c828c0"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/02602e9d-57be-4486-8138-7e8650c828c0"
    }
  }
}
